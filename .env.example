# Copy to .env locally or on the VPS, or set these values directly in PM2.
# dotenv loads .env only as a fallback; existing shell/PM2 env vars win.

# Runtime
APP_ENV=production
NODE_ENV=production
PORT=10000
REQUEST_BODY_LIMIT=5mb
DISABLE_KEEP_ALIVE=true
# KEEP_ALIVE_URL=https://your-api.example.com/keep-alive
# KEEP_ALIVE_INTERVAL_MS=300000

# Logging
LOG_LEVEL=info
LOG_ERROR_STACKS=false

# Error monitoring
# Use the same Sentry project for all environments and filter by environment.
# SENTRY_ENVIRONMENT is optional; it defaults to APP_ENV, then NODE_ENV.
# Keep SENTRY_AUTH_TOKEN out of this API unless you add explicit artifact upload.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Required infrastructure
REDIS=redis://localhost:6379
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
# Use either GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=/srv/pawify/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Cron/admin endpoint auth
NOTIFY_API_KEY=replace-with-long-random-token

# Email
GMAIL_EMAIL=your-address@gmail.com
GMAIL_PASSWORD=your-app-password

# Optional music providers
MUSICBRAINZ_USER_AGENT=Pawify/1.0 (you@example.com)
# GENIUS_ACCESS_TOKEN=
# DISCOGS_TOKEN=

# Music API rate limiting
MUSICBRAINZ_DELAY_MS=650
MUSICBRAINZ_BACKGROUND_DELAY_MS=1250
MUSICBRAINZ_MIN_RATE_LIMIT_WAIT_MS=1500
MUSICBRAINZ_RETRY_AFTER_BUFFER_MS=1000

# Cache TTLs
ARTIST_CACHE_TTL_HOURS=336
TRANSIENT_ARTIST_CACHE_TTL_HOURS=24
RELEASE_LYRICS_CACHE_TTL_HOURS=336
CACHE_DEFAULT_TTL_HOURS=336
ARTIST_METADATA_REFRESH_TTL_MS=2419200000
TRANSIENT_REMOTE_VALUE_RETRY_WINDOW_MS=300000
ARTIST_PROFILE_IMAGE_REFRESH_TTL_MS=2419200000

# Background tasks
BACKGROUND_TASK_RESULT_RETENTION_MS=90000
BACKGROUND_TASK_CLEANUP_INTERVAL_MS=30000
BACKGROUND_TASK_MAX_CONCURRENCY=8
BACKGROUND_TASK_PENDING_ORPHAN_TTL_MS=600000
BACKGROUND_TASK_WORKER_TIMEOUT_MS=450000
BACKGROUND_TASK_SUBTASK_ITEM_LIMIT=30
BACKGROUND_TASK_PROGRESS_NOTIFY_THROTTLE_MS=2000
BACKGROUND_TASK_COVER_ART_REQUEST_CONCURRENCY=40
BACKGROUND_TASK_TRACK_LYRICS_REQUEST_CONCURRENCY=20
BACKGROUND_TASK_ARTIST_PROFILE_IMAGE_REQUEST_CONCURRENCY=10
NOTIFY_NEW_RELEASES_LOCK_TTL_MS=3600000
