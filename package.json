{
    "name": "pawify-api",
    "scripts": {
        "build": "npm run test:all && npm run build:unchecked",
        "build:unchecked": "tsc",
        "build:watch": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test \"lib-test/**/*.test.js\"",
        "test:coverage": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test \"lib-test/**/*.test.js\"",
        "test:integration": "tsc -p tsconfig.test.json && firebase emulators:exec --only auth,database,firestore --project pawify-test \"node --test lib-test/test/emulator/**/*.test.js\"",
        "test:all": "npm test && npm run test:integration",
        "start": "node --enable-source-maps lib/index.js",
        "dev": "ts-node src/index.ts",
        "verify": "npm run typecheck && npm test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@sentry/node": "^10.53.1",
        "dotenv": "^17.4.2",
        "express": "^4.21.2",
        "firebase-admin": "^14.2.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.13.8",
        "firebase-tools": "^15.24.0",
        "prettier": "^3.9.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2"
    },
    "overrides": {
        "uuid": "^11.1.1"
    },
    "private": true
}
